rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Imágenes de productos y paquetes: lectura pública, escritura solo autenticados
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /packages/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Imágenes de pedidos y comprobantes: solo usuarios autenticados
    match /orders/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
    match /payment_proofs/{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
